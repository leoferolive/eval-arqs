# Configuração do experimento — ajuste aqui, não no run.sh.
# Versão do protocolo (muda quando guias/tarefas mudam; o report só compara runs da versão atual)
PROTOCOL=${PROTOCOL:-v2}

MODEL=${MODEL:-claude-sonnet-5}
EFFORT=${EFFORT:-medium}

# Orçamento em USD (janela móvel de 7 dias, somando results/runs.csv)
BUDGET_WEEKLY_USD=${BUDGET_WEEKLY_USD:-90}
# Teto duro por run (passado ao agente via --max-budget-usd; também é o mínimo exigido de saldo)
RUN_MAX_USD=${RUN_MAX_USD:-15}

# Limites do plano Claude (fração de uso da janela, lida do rate_limit_event da última run)
PLAN_5H_MAX=${PLAN_5H_MAX:-0.85}
PLAN_7D_MAX=${PLAN_7D_MAX:-0.95}

# Tempo máximo de uma run do agente (segundos)
AGENT_TIMEOUT=${AGENT_TIMEOUT:-3600}

# Mutation testing (PIT) é lento; 1 = roda, 0 = pula
RUN_PIT=${RUN_PIT:-1}

# Portas usadas nos testes de aceitação
APP_PORT=${APP_PORT:-18080}
WIREMOCK_PORT=${WIREMOCK_PORT:-18089}
